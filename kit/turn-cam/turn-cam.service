# turn-cam -- the camera's H.264 off the AVB bus and into a socket.
#
# The camera picture is only on the bus while something asks the camera ECU for
# a view; the asking lives in the app (JavaScript, SOME/IP), and this program
# only receives. It therefore holds nothing when the camera is off: no request,
# no video, Drive Recorder keeps the cameras.
#
# The decoder that follows it (turn-decode --dir /dev/shm/turn-view) is a
# separate unit, so this one cannot take the decoder down with it.
[Unit]
Description=Turn View camera capture (AVB H.264 to the decoder's socket)
# The decoder may start first or later; this one reconnects to its socket.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/var/opt/turn-cam/current/turn-cam --dir /dev/shm/turn-view
Restart=always
RestartSec=3
# The callback runs on the AVB bridge's thread: a receiver that is scheduled
# late delays the packets of every other receiver on that stream, including
# the unit's own view.
Nice=-5
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
