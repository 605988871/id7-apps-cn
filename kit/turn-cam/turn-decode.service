# turn-decode -- the camera's H.264 into the atlas the cluster's map layer takes.
#
# CarLife Map's decoder, built into this component and run with --dir, so the
# two apps never share a socket, a crop.json or a report: this one listens on
# /dev/shm/turn-view/h264.sock (where turn-cam writes) and hands the picture to
# whoever listens on /dev/shm/turn-view/live.sock (the app), at exactly the size
# the map layer asked for.
#
# A camera picture is the whole frame, so crop.json asks for no cut and keeps
# the aspect ratio; the app writes it. Nothing else here knows what a camera is.
[Unit]
Description=Turn View decoder (H.264 to the cluster's map area)
# turn-cam may start first or later: it reconnects to this one's socket.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/var/opt/turn-cam/current/turn-decode --dir /dev/shm/turn-view
Restart=always
RestartSec=3
# Decoding is real time; a decoder scheduled late makes the picture stutter.
# It still yields to everything the unit considers more important.
Nice=-5
# Nothing to write but its report, its sockets and the frames it hands out.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
