{
  "id": "turn-cam",
  "kind": "tool",
  "version": "0.1.0",
  "title": "转向影像取流与解码",
  "description": "把车机摄像头在 AVB 总线上送出的 H.264 接下来，写成 Annex B 交给自己带的解码器，解出仪表盘地图区域那一块要的画面。只接收，不改变任何字节；也不自己请求摄像头（请求由应用通过 SOME/IP 完成），所以不会和行车记录仪或原厂摄像头视图抢设备。解码器是 CarLife Map 那一个，用 --dir 跑在自己的目录里，两个应用互不干扰（iDrive 7）",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "files": [
    {
      "path": "turn-cam",
      "mode": "0755"
    },
    {
      "path": "turn-decode",
      "mode": "0755"
    },
    {
      "path": "install.sh",
      "mode": "0755"
    },
    {
      "path": "remove.sh",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "turn-decode.service"
    },
    {
      "name": "turn-cam.service"
    }
  ],
  "enable": [
    {
      "unit": "turn-decode.service",
      "target": "multi-user.target"
    },
    {
      "unit": "turn-cam.service",
      "target": "multi-user.target"
    }
  ],
  "postInstall": [
    "install.sh"
  ],
  "restart": [
    "turn-decode.service",
    "turn-cam.service"
  ]
}
