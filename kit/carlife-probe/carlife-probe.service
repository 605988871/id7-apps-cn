[Unit]
Description=CarLife probe (read-only look at how the unit's own CarLife talks to the phone)
Documentation=file:/var/opt/carlife-probe/current/README.md
After=multi-user.target
# it is a two-second read of /proc and /sys: no reason for systemd's start limit
# to ever give up on it
StartLimitIntervalSec=0

[Service]
Type=simple
# the loop lives in the script, so there is no timer to forget to enable; the
# report is never more than a few seconds old, which is what makes it usable
# while the driver switches between wired CarLife and this app
ExecStart=/bin/sh /var/opt/carlife-probe/current/probe.sh 3
Restart=always
RestartSec=5
# the app runs as tm_oap_app and reads /dev/shm/carlife-probe/report.txt;
# nothing in the app needs root and nothing here needs the app's uid
Nice=10

[Install]
WantedBy=multi-user.target
