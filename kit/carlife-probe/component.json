{
  "id": "carlife-probe",
  "kind": "tool",
  "version": "0.2.0",
  "title": "CarLife 诊断",
  "description": "只读地看原车 carlife 进程怎么取手机的：它是直接操作 USB 设备（AOA），还是拿到了一块 USB 网卡在里面跑 IP。答案写在 /dev/shm/carlife-probe/report.txt，「CarLife 诊断」应用分屏显示（iDrive 7）",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "files": [
    {
      "path": "probe.sh",
      "mode": "0755"
    },
    {
      "path": "install.sh",
      "mode": "0755"
    },
    {
      "path": "remove.sh",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "carlife-probe.service"
    }
  ],
  "enable": [
    {
      "unit": "carlife-probe.service",
      "target": "multi-user.target"
    }
  ],
  "postInstall": [
    "install.sh"
  ]
}
