# CarLife probe (root): keeps /dev/shm/carlife-probe-root.txt following the
# CarLife session, so the app shows a report taken while the phone was connected.
#
# Read-only: the script reads /proc, /sys and /etc/cinemo and writes only its
# report. It loads no module, changes no firewall rule and signals no process.
[Unit]
Description=CarLife probe (root) report

[Service]
Type=simple
ExecStart=/bin/sh /var/opt/carlife-probe-root/current/probe-root.sh loop
# the script never exits; a service that stops makes the head unit's lifecycle
# reboot the unit, so it is restarted as well if it ever does
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
