{
  "id": "carlife-wireless",
  "kind": "tool",
  "version": "0.6.0",
  "title": "CarLife 无线投屏取流与解码",
  "description": "车机连上手机热点后，通过 WiFi 接收百度 CarLife 的画面（H.264），在车机侧解码成完整画面供中控屏显示，并把触摸回传给手机。独立的无线链路，不触碰原车 CarLife 的 USB 进程。",
  "internet": true,
  "uids": [65534],
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "uninstallable": true,
  "files": [
    {
      "path": "carlife-link",
      "mode": "0755"
    },
    {
      "path": "carlife-decode",
      "mode": "0755"
    },
    {
      "path": "wifi-bridge",
      "mode": "0755"
    },
    {
      "path": "carlife-wifi.service",
      "mode": "0644"
    },
    {
      "path": "crop.json",
      "mode": "0644"
    },
    {
      "path": "run.sh",
      "mode": "0755"
    },
    {
      "path": "find-phone.sh",
      "mode": "0755"
    },
    {
      "path": "install.sh",
      "mode": "0755"
    },
    {
      "path": "remove.sh",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "carlife-wireless.service"
    },
    {
      "name": "carlife-wifi.service"
    }
  ],
  "enable": [
    {
      "unit": "carlife-wireless.service",
      "target": "multi-user.target"
    },
    {
      "unit": "carlife-wifi.service",
      "target": "multi-user.target"
    }
  ],
  "postInstall": [
    "install.sh"
  ],
  "postRemove": [
    "remove.sh"
  ]
}
