# carlife-decode -- CarLife's H.264 to the pictures the cluster and HUD draw.
#
# CarLife gives the head unit one H.264 picture and no navigation data at all
# (the vehicle SDK's navigation module has two states, idle and running), so the
# map and the turn card can only come from the picture itself: decode it here,
# cut the wanted piece out, and hand the app frames it can draw.
#
# It loads the unit's own Intel MSDK library (libmfxhw64.so, API 1.24) and libva
# with dlopen, so it has nothing to link against and nothing to install beside
# it. That is also why it is a separate program and not part of the preloaded
# library: decoding belongs in a process that may crash without taking CarLife
# with it.
[Unit]
Description=CarLife decoder (H.264 to the cluster's map and the HUD's card)
# The renderer's clients may start first; this one waits on its socket, so the
# order does not matter. Restarted forever: a decoder that stops is a black
# cluster, and nothing says why.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/var/opt/carlife-tap/current/carlife-decode
Restart=always
RestartSec=3
# Encoding work is real time; a decoder that is scheduled late makes the map
# stutter. It still yields to everything the unit considers more important.
Nice=-5
# Nothing to write but its report and its sockets.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
