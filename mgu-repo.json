{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "network": [
        "cn_doom"
      ],
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/make_icon.js",
        "kit/tools/build_diagnostic_zh.py",
        "kit/tools/build_diagnostic_ru.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    }
  },
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU 渲染器",
      "description": "应用自带的 GPU 渲染器（mgu-render）：以 60 fps 渲染应用，与 MGU Store 的渲染器并存；随应用一同安装（iDrive 7 与 iDrive 8）",
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/inputgate/tool",
      "title": "控制器门控",
      "description": "使应用取得 iDrive 控制器（标记页、翻页按钮、设置、Doom）；下次启动时载入 HMI（iDrive 7 与 iDrive 8）",
      "needs": [
        "renderer"
      ],
      "optional": false,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "carlife-link",
      "path": "kit/carlife-link",
      "title": "CarLife 无线链路",
      "description": "车机自己做无线 CarLife 的主机：在局域网里找到手机，连上它的六个 CarLife 通道，完成握手，收下画面与声音数据并把触摸送回去；状态由「无线 CarLife」应用显示（iDrive 7）",
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "carlife-probe",
      "path": "kit/carlife-probe",
      "title": "CarLife 诊断",
      "description": "只读地看原车 carlife 进程怎么取手机的：它直接操作 USB 设备（AOA），还是拿到一块 USB 网卡在里面跑 IP；结果由「CarLife 诊断」应用分屏显示（iDrive 7）",
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    }
  ]
}
