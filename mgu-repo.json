{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "network": [
        "cn_doom"
      ],
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/make_icon.js",
        "kit/tools/build_diagnostic_zh.py",
        "kit/tools/build_diagnostic_ru.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    }
  },
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU 渲染器",
      "description": "应用自带的 GPU 渲染器（mgu-render）：以 60 fps 渲染应用，与 MGU Store 的渲染器并存；随应用一同安装（iDrive 7 与 iDrive 8）",
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/inputgate/tool",
      "title": "控制器门控",
      "description": "使应用取得 iDrive 控制器（标记页、翻页按钮、设置、Doom）；下次启动时载入 HMI（iDrive 7 与 iDrive 8）",
      "needs": [
        "renderer"
      ],
      "optional": false,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "carlife-probe-root",
      "path": "kit/carlife-probe/tool",
      "title": "CarLife 诊断（root）",
      "description": "只读查看 CarLife 进程与打开的文件（有 USB 设备即说明画面走 USB 不走网络）、解码、配置、本机服务与可用软件；数据在诊断应用里显示（iDrive 7）",
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "carlife-tap",
      "path": "kit/carlife-tap",
      "title": "CarLife 画面取流",
      "description": "把 CarLife 收到的画面复制一份给 CarLife Map（仪表盘与 HUD）；只读、不改流、不解码，装完下次启动车机生效（iDrive 7）",
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    }
  ]
}
