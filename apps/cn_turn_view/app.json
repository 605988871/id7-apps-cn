{
  "id": "cn_turn_view",
  "title": "转向影像",
  "description": "打转向灯时把那一侧的摄像头画面放到仪表盘中间的地图区域：左转看左侧，右转看右侧（也可选前视）。画面由车机自己的摄像头经 AVB 送来，应用只负责请求和显示，不占用行车记录仪；灯灭后自动收起，回到原来的地图。实验功能",
  "version": "0.1.0",
  "vendor": "custom",
  "loggingId": "OAA6",
  "iconGlyph": "gauge",
  "mguHmi": [
    "ID7"
  ],
  "autostart": true,
  "requires": {
    "idrive7-renderd": "2.1.15",
    "turn-cam": "0.1.0"
  },
  "signals": {
    "de.bmw.body.Light": {
      "_optional": "the turn signals: without them nothing can trigger the camera",
      "StatusFunctionsIndicators": "s"
    },
    "de.bmw.infotainment.video.cameraproxy.CameraProxy": "*",
    "de.bmw.infotainment.video.cameraproxy.ICAM2Proxy": "*",
    "de.bmw.dass.XView3D": {
      "_optional": "the surround-view state: read only, to see which view holds the cameras",
      "CurrentState": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "转向影像",
      "buttons": [
        [
          "BTN_PAGE",
          "诊断"
        ],
        [
          "BTN_SETTINGS",
          "设置"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "target",
      "label": "显示在",
      "type": "choice",
      "default": "cluster",
      "options": [
        [
          "cluster",
          "仪表盘中间"
        ],
        [
          "off",
          "关闭"
        ]
      ]
    },
    {
      "key": "trigger",
      "label": "什么时候显示",
      "type": "choice",
      "default": "both",
      "options": [
        [
          "both",
          "左转和右转"
        ],
        [
          "left",
          "只左转"
        ],
        [
          "right",
          "只右转"
        ],
        [
          "hazard",
          "双闪"
        ]
      ]
    },
    {
      "key": "viewMode",
      "label": "看哪一路",
      "type": "choice",
      "default": "side",
      "options": [
        [
          "side",
          "那一侧的摄像头"
        ],
        [
          "front",
          "前摄像头"
        ],
        [
          "rear",
          "后摄像头"
        ],
        [
          "all",
          "全部摄像头（画面分割）"
        ]
      ]
    },
    {
      "key": "application",
      "label": "请求方式",
      "type": "choice",
      "default": "SIDEVIEW",
      "options": [
        [
          "SIDEVIEW",
          "侧视（泊车侧视）"
        ],
        [
          "DR_ACTIVE",
          "行车记录视角"
        ]
      ]
    },
    {
      "key": "sideLeft",
      "label": "左侧视角编号",
      "type": "number",
      "default": 1,
      "steps": [
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ]
    },
    {
      "key": "sideRight",
      "label": "右侧视角编号",
      "type": "number",
      "default": 2,
      "steps": [
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ]
    },
    {
      "key": "holdSec",
      "label": "灯灭后再显示",
      "type": "number",
      "unit": "秒",
      "default": 2,
      "steps": [
        0,
        0.5,
        1,
        1.5,
        2,
        3,
        4,
        5,
        6,
        8
      ]
    },
    {
      "key": "fps",
      "label": "帧率",
      "type": "number",
      "unit": "帧/秒",
      "default": 15,
      "steps": [
        5,
        8,
        10,
        12,
        15,
        20,
        24,
        30
      ]
    },
    {
      "key": "zoom",
      "label": "画面缩放",
      "type": "number",
      "unit": "%",
      "default": 100,
      "steps": [
        100,
        110,
        120,
        130,
        140,
        150,
        175,
        200
      ]
    },
    {
      "key": "offsetX",
      "label": "画面左右微调",
      "type": "number",
      "unit": "像素",
      "default": 0,
      "steps": [
        -120,
        -80,
        -60,
        -40,
        -20,
        -10,
        0,
        10,
        20,
        40,
        60,
        80,
        120
      ]
    },
    {
      "key": "offsetY",
      "label": "画面上下微调",
      "type": "number",
      "unit": "像素",
      "default": 0,
      "steps": [
        -80,
        -60,
        -40,
        -20,
        -10,
        0,
        10,
        20,
        40,
        60,
        80
      ]
    },
    {
      "key": "keepAlive",
      "label": "常开（不等转向灯）",
      "type": "bool",
      "default": false
    }
  ]
}
