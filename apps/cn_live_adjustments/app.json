{
  "id": "cn_live_adjustments",
  "title": "Engine Config",
  "description": "面向 BMW MGU ID7 的发动机配置。排气阀门：通过车辆自身诊断链路执行原厂/开/关，或随驾驶模式同步（运动模式开、Eco Pro 关）；可阻止 DME 超时保持，超过设定转速时交还车辆控制。在设置中选择 BM3 或 MHD 后：发动机地图切换、回火声、主动声音与最大冷却。实验功能：独立开关控制 xDrive 关闭至本次点火循环（DSC LMV_FUNKTION）",
  "version": "0.9.9",
  "vendor": "custom",
  "loggingId": "OAA0",
  "iconGlyph": "sliders",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18",
    "mgu-inputgate": "1.1.0"
  },
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "xDrive live: g and yaw rate",
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs",
      "statusYawVelocityVehicle": "rs"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "xDrive live: the front / rear split",
      "basicDataSet": "s"
    },
    "de.bmw.powertrain.Powertrain": {
      "_optional": "xDrive live: wheel slip",
      "ActualValueRPMWheel": "s"
    },
    "de.bmw.chassis.SteeringAngle": {
      "_optional": "xDrive live: the steering wheel",
      "ActualSteeringAngleDriver": "s",
      "actualSteeringAngleDriverNoCRC": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Engine Config",
      "buttons": [
        [
          "BTN_OPEN",
          "Open"
        ],
        [
          "BTN_CLOSE",
          "Close"
        ],
        [
          "BTN_OEM",
          "OEM"
        ],
        [
          "BTN_DRIVE",
          "Drive mode"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "arm",
      "label": "Exhaust Flap",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Disarmed · simulated (safe)"
        ],
        [
          "on",
          "Armed · actuates the real valve"
        ]
      ]
    },
    {
      "key": "hold",
      "label": "Hold Open / Close",
      "type": "choice",
      "default": "on",
      "options": [
        [
          "on",
          "On · sent again every 15 s"
        ],
        [
          "off",
          "Off · the car takes over after ~20 s"
        ]
      ]
    },
    {
      "key": "closeLimit",
      "label": "Close: hand back above",
      "type": "choice",
      "default": "4000",
      "options": [
        [
          "2500",
          "2,500 rpm"
        ],
        [
          "3000",
          "3,000 rpm"
        ],
        [
          "3500",
          "3,500 rpm"
        ],
        [
          "4000",
          "4,000 rpm"
        ],
        [
          "4500",
          "4,500 rpm"
        ],
        [
          "5000",
          "5,000 rpm"
        ],
        [
          "5500",
          "5,500 rpm"
        ],
        [
          "off",
          "Never (not recommended)"
        ]
      ]
    },
    {
      "key": "tuner",
      "label": "Tuning software",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Off · nothing is sent to the car (safe)"
        ],
        [
          "bm3",
          "BM3 · engine map, burbles, ASD"
        ],
        [
          "mhd",
          "MHD · engine map, Max Cooling"
        ]
      ]
    },
    {
      "key": "mapPin",
      "label": "PIN for Engine Map and Burbles",
      "type": "bool",
      "default": false,
      "when": {
        "tuner": [
          "bm3",
          "mhd"
        ]
      }
    },
    {
      "key": "mapPinCode",
      "label": "Engine Map and Burbles PIN",
      "type": "object",
      "default": {},
      "hidden": true
    },
    {
      "key": "xdrive",
      "label": "xDrive (experimental)",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Off · nothing is sent (safe)"
        ],
        [
          "on",
          "On · xDrive tab, xDrive off until ignition off"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "on",
          "Always"
        ],
        [
          "off",
          "Never"
        ]
      ]
    }
