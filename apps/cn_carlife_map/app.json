{
  "id": "cn_carlife_map",
  "title": "CarLife Map",
  "description": "把手机 CarLife 的画面送到 iDrive 7 仪表盘地图区和 HUD，取流组件随应用一同安装。画面经 cluster-render 渲染；若仪表盘上没有出现画面，先确认车上已装 Cluster renderer。实验功能",
  "version": "1.1.4",
  "vendor": "custom",
  "loggingId": "OAA6",
  "iconGlyph": "gauge",
  "mguHmi": [
    "ID7"
  ],
  "autostart": true,
  "requires": {
    "idrive7-renderd": "2.1.15",
    "carlife-tap": "0.3.0"
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "CarLife Map",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "target",
      "label": "Show map on",
      "type": "choice",
      "default": "cluster",
      "options": [
        [
          "off",
          "Off"
        ],
        [
          "cluster",
          "Cluster only"
        ],
        [
          "hud",
          "HUD only"
        ],
        [
          "both",
          "Cluster and HUD"
        ]
      ]
    },
    {
      "key": "source",
      "label": "Picture source",
      "type": "choice",
      "default": "demo",
      "options": [
        [
          "demo",
          "Test picture"
        ],
        [
          "carlife",
          "CarLife (live)"
        ],
        [
          "tcp",
          "Network (TCP)"
        ],
        [
          "fifo",
          "Local pipe"
        ]
      ]
    },
    {
      "key": "fps",
      "label": "Frame rate",
      "type": "number",
      "unit": "fps",
      "default": 15,
      "steps": [
        5,
        10,
        15,
        20,
        30
      ]
    },
    {
      "key": "hudWidth",
      "label": "HUD width",
      "type": "number",
      "unit": "%",
      "default": 57,
      "steps": [
        40,
        50,
        57,
        65,
        75,
        85
      ]
    },
    {
      "key": "hudX",
      "label": "HUD left / right",
      "type": "number",
      "unit": "px",
      "default": 0,
      "steps": [
        -160,
        -120,
        -80,
        -40,
        0,
        40,
        80,
        120,
        160
      ]
    },
    {
      "key": "hudY",
      "label": "HUD up / down",
      "type": "number",
      "unit": "px",
      "default": 0,
      "steps": [
        -80,
        -60,
        -40,
        -20,
        0,
        20,
        40,
        60,
        80
      ]
    },
    {
      "key": "hudKeep",
      "label": "HUD on top of alerts",
      "type": "bool",
      "default": false
    },
    {
      "key": "mapTop",
      "label": "Map crop top",
      "type": "number",
      "unit": "%",
      "default": 8,
      "steps": [0, 4, 8, 12, 16, 20, 24]
    },
    {
      "key": "mapBottom",
      "label": "Map crop bottom",
      "type": "number",
      "unit": "%",
      "default": 0,
      "steps": [0, 4, 8, 12, 16, 20, 24]
    },
    {
      "key": "mapLeft",
      "label": "Map crop left",
      "type": "number",
      "unit": "%",
      "default": 0,
      "steps": [0, 5, 10, 15, 20, 25, 30]
    },
    {
      "key": "mapRight",
      "label": "Map crop right",
      "type": "number",
      "unit": "%",
      "default": 0,
      "steps": [0, 5, 10, 15, 20, 25, 30]
    },
    {
      "key": "mapFit",
      "label": "Map crop fit",
      "type": "choice",
      "default": "band",
      "options": [
        [
          "band",
          "Fill (cut to shape)"
        ],
        [
          "stretch",
          "Stretch"
        ],
        [
          "letterbox",
          "Fit (bars)"
        ]
      ]
    }
  ]
}
