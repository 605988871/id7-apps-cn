{
  "id": "cn_carlife_map",
  "title": "CarLife Map",
  "description": "把手机 CarLife 的导航送到 iDrive 7：仪表盘显示地图，HUD 显示 CarLife 自己的导航条（箭头、车道、路名）。取流与解码组件随应用一同安装，画面在车机侧解码后裁切；若仪表盘上没有出现画面，先确认车上已装 Cluster renderer。HUD 可调宽度与不透明度；实验功能",
  "version": "1.4.8",
  "vendor": "custom",
  "loggingId": "OAA6",
  "iconGlyph": "gauge",
  "mguHmi": [
    "ID7"
  ],
  "autostart": true,
  "requires": {
    "idrive7-renderd": "2.1.15",
    "carlife-tap": "0.4.7"
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "CarLife Map",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "target",
      "label": "Show on",
      "type": "choice",
      "default": "cluster",
      "options": [
        [
          "off",
          "Off"
        ],
        [
          "cluster",
          "Cluster only"
        ],
        [
          "hud",
          "HUD only"
        ],
        [
          "both",
          "Cluster and HUD"
        ]
      ]
    },
    {
      "key": "source",
      "label": "Picture source",
      "type": "choice",
      "default": "demo",
      "options": [
        [
          "demo",
          "Test picture"
        ],
        [
          "carlife",
          "CarLife (live)"
        ],
        [
          "tcp",
          "Network (TCP)"
        ],
        [
          "fifo",
          "Local pipe"
        ]
      ]
    },
    {
      "key": "fps",
      "label": "Frame rate",
      "type": "number",
      "unit": "fps",
      "default": 15,
      "steps": [
        5,
        10,
        15,
        20,
        30
      ]
    },
    {
